# written for you by `npm run deploy`, into .env.local. these are the same settings, for reference
# chain the contract lives on: localhost | sepolia | mainnet
VITE_CHAIN=sepolia
# address of the deployed contract. leave empty and minting stays closed
VITE_CONTRACT=
# optional. the collection's page on OpenSea; its mark in the header stays dim until this is set
VITE_OPENSEA=
# optional. WalletConnect only switches on when a Reown project id is given
VITE_WC_PROJECT_ID=

# read by scripts/deploy.mjs if set, asked for if not. never commit real values
# ALCHEMY_KEY=
# ETHERSCAN_KEY=
# DEPLOYER_KEY=
